\@writefile{toc}{\contentsline {section}{\numberline {4}AdaLN FiLM and the Checkpoint Persistence Bug}{4}{section.4}\protected@file@percent }
\newlabel{sec:bug}{{4}{4}{AdaLN FiLM and the Checkpoint Persistence Bug}{section.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}An Apparent (but Invalid) Strong Result}{4}{subsection.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}The Two Errors}{4}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Corrected Causal Ablation (Pure LM Loss, Verified Weights)}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Causal ablation with verified non-zero FiLM weights, pure LM cross-entropy (no auxiliary terms). The corrected story is the opposite of the artifact: removing FiLM costs only $+0.044$; freezing the latent state costs $+0.0002$.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:causal}{{4}{5}{Causal ablation with verified non-zero FiLM weights, pure LM cross-entropy (no auxiliary terms). The corrected story is the opposite of the artifact: removing FiLM costs only $+0.044$; freezing the latent state costs $+0.0002$}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Corrected causal ablation. The $24\%$ improvement over vanilla ($3.53\!\to \!2.70$) comes from the LoRA adapters; removing FiLM or freezing the latent state leaves the loss essentially unchanged (red reference line at the trained level). The previously reported $\Delta =11.44$ for AdaLN FiLM was a composite-loss/checkpoint-bug artifact and is \emph  {not} shown here.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:ablation}{{2}{5}{Corrected causal ablation. The $24\%$ improvement over vanilla ($3.53\!\to \!2.70$) comes from the LoRA adapters; removing FiLM or freezing the latent state leaves the loss essentially unchanged (red reference line at the trained level). The previously reported $\Delta =11.44$ for AdaLN FiLM was a composite-loss/checkpoint-bug artifact and is \emph {not} shown here}{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Multiplicative FiLM: Structural Symmetry Breaking}{5}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Layer Specialization Growth}{5}{subsection.5.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Monotonic growth of inter-layer modulation variance: $6.6\times $ over 2{,}650 steps, with no saturation plateau. Contrast the additive/AdaLN plateau of $w_{\mathrm  {std}}= 0.033$.}}{5}{table.5}\protected@file@percent }
\newlabel{tab:wstd}{{5}{5}{Monotonic growth of inter-layer modulation variance: $6.6\times $ over 2{,}650 steps, with no saturation plateau. Contrast the additive/AdaLN plateau of $\wstd = 0.033$}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Structural symmetry breaking. Inter-layer modulation variance $w_{\mathrm  {std}}$ grows monotonically ($6.6\times $), far above the additive/AdaLN plateau (gray dashed). During the two synchronization bursts (red dashed, steps $1750$/$1950$, where gradient cosine spikes to $0.63$/$0.70$), $w_{\mathrm  {std}}$ does \emph  {not} collapse---it continues rising ($0.348\!\to \!0.382$), and loss recovers to a lower attractor afterward.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:wstd-growth}{{3}{6}{Structural symmetry breaking. Inter-layer modulation variance $\wstd $ grows monotonically ($6.6\times $), far above the additive/AdaLN plateau (gray dashed). During the two synchronization bursts (red dashed, steps $1750$/$1950$, where gradient cosine spikes to $0.63$/$0.70$), $\wstd $ does \emph {not} collapse---it continues rising ($0.348\!\to \!0.382$), and loss recovers to a lower attractor afterward}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Phase-Plane Dynamics and Regime Hopping}{6}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces $w_{\mathrm  {std}}$--cos phase plane. The system departs the symmetric corner (Phase~I, homogeneous layers) and settles into Phase~IV, a metastable coupled hierarchy, via intermittent synchronization bursts. Phase classification here is \emph  {structural} only; the causal ablation (Figure~\ref {fig:ablation}) shows this differentiation does not entail functional specialization.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:phase-plane}{{4}{6}{$\wstd $--cos phase plane. The system departs the symmetric corner (Phase~I, homogeneous layers) and settles into Phase~IV, a metastable coupled hierarchy, via intermittent synchronization bursts. Phase classification here is \emph {structural} only; the causal ablation (Figure~\ref {fig:ablation}) shows this differentiation does not entail functional specialization}{figure.4}{}}
