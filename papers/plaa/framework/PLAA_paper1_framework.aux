\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Causality Test Suite}{5}{subsection.3.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Causality test results. FiLM modulation is strongly causal but disruptive: removal \emph  {lowers} loss, indicating the modulation degrades LM quality while demonstrating genuine computational influence. The effect is predominantly static (freezing $S$ changes loss by only 1.33).\\ \textsuperscript  {$\dagger $}$\Delta = \mathrm  {Loss}_{\mathrm  {baseline}} - \mathrm  {Loss}_{\mathrm  {ablation}}$; positive $\Delta $ means removing the component \emph  {lowers} loss (its presence was harmful), negative means removing it raises loss (it was helpful). Here $\Delta = 14.68 - 3.24 \approx +11.44$ confirms FiLM is disruptive.}}{5}{table.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Causal influence comparison (ablation $\Delta $PPL). FiLM modulation produces $5.7\times $ stronger effect upon removal ($\Delta \mathrm  {PPL} = 11.44$) compared to additive injection ($\Delta \mathrm  {PPL} = 2.01$). Note: positive $\Delta $ indicates the component was \emph  {increasing} loss---the modulation is disruptive to language modeling but demonstrates genuine computational influence over the residual stream.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:causal-comparison}{{3}{6}{Causal influence comparison (ablation $\Delta $PPL). FiLM modulation produces $5.7\times $ stronger effect upon removal ($\Delta \mathrm {PPL} = 11.44$) compared to additive injection ($\Delta \mathrm {PPL} = 2.01$). Note: positive $\Delta $ indicates the component was \emph {increasing} loss---the modulation is disruptive to language modeling but demonstrates genuine computational influence over the residual stream}{figure.3}{}}
